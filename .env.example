#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
### STANDARD CONFIGURATION (CHANGE THIS!)
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

# Host
# Your public hostname: bare name, no scheme, no port, no trailing slash.
# Passkeys are bound to it - changing it later invalidates every registered passkey.
HOST=gym.example.com

# Cloudflared tunnel token for remote access
CLOUDFLARED_TUNNEL_TOKEN=your-token

# Your timezone
TZ=Europe/Berlin

#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#
### ADVANCED CONFIGURATION (DO NOT CHANGE IF NOT NEEDED)
#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#-#

#################################
# --- interface configuration ---
#################################

# Name shown in the passkey prompt.
RP_NAME=openGym

# Language for the sign-in screen and new profiles (e.g. en, de, fr). Empty = browser language.
DEFAULT_LANG=

#################################
# --- access control ---
#################################

# The first profile created on an empty instance becomes its admin.
# Register your own profile right after the first start, before sharing the address.
FIRST_USER_ADMIN=1

# Comma-separated user ids that get the admin dashboard (Settings -> Account -> Account ID).
ADMIN_UIDS=

# Require an invite code to create new profiles.
# Leave at 0 until your own (admin) profile exists - otherwise nobody can create the first code.
INVITE_ONLY=0

# Offer "Continue without account". Guests store data in the browser only.
ALLOW_GUEST=0

# Name-and-password sign-in next to passkeys. Passkeys are the safer default.
PASSWORD_LOGIN=0

#################################
# --- security & runtime ---
#################################

# How long a sign-in lasts, in days.
SESSION_DAYS=90

# Record sign-ins and admin actions in the activity log.
AUDIT_LOG=1

# Events / days kept in the activity log (0 = no limit).
AUDIT_MAX=5000
AUDIT_DAYS=90

# Record the caller's address: off, net (network only, e.g. 203.0.113.0/24) or full.
AUDIT_IP=off


#################################
# --- AI coach ---
#################################

# The coach is switched on and configured in the app, not here:
# Settings -> Account -> Admin dashboard -> AI Coach. Use an API-key provider
# (Anthropic, OpenAI, Gemini or OpenAI-compatible such as Ollama). The key is stored
# encrypted in the api_storage volume (coach.json).

# Time budget per coach job in ms (default 300000 = 5 min, minimum 60000).
# Only a local CPU model behind the OpenAI-compatible provider needs more, e.g. 1500000.
# COACH_JOB_TIMEOUT_MS=1500000

# Kill switch: forces the coach off instance-wide, overriding the admin toggle.
# COACH_DISABLED=1

#################################
# --- media uploads ---
#################################

# Photos and videos of custom exercises and workouts (0 = link field only).
MEDIA_UPLOADS=1

# Space per profile in MB (0 = no cap). Worst case disk use = quota x number of profiles.
MEDIA_QUOTA_MB=200

# Uploads are refused while the data volume has less free space than this (MB).
MEDIA_MIN_FREE_MB=512

# Largest video in MB. Keep below MEDIA_UPLOAD_MAX in docker-compose.yml (48m).
MEDIA_VIDEO_MAX_MB=40

#################################
# --- notifications ---
#################################

# Contact address sent with push notifications. Empty = https://HOST.
VAPID_SUBJECT=

